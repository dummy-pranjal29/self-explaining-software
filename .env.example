# Self-Evolving Software Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION (Choose one)
# =============================================================================

# Option 1: SQLite (default - no configuration needed)
# Uses db.sqlite3 in project root

# Option 2: PostgreSQL (recommended for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/ses"

# Option 3: MongoDB Atlas
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ses"

# =============================================================================
# LLM CONFIGURATION (OpenAI)
# =============================================================================

# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-api-key-here"

# Optional: Specify model (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4"

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

SECRET_KEY="generate-a-secure-random-key-here"
DEBUG=False
ALLOWED_HOSTS="localhost,127.0.0.1,your-domain.com"

# =============================================================================
# CELERY / BACKGROUND TASKS (Optional)
# =============================================================================

CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# =============================================================================
# CORS (For frontend access)
# =============================================================================

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# =============================================================================
# FRONTEND API URL (Optional)
# =============================================================================

# For production: Set the API base URL if frontend is on different domain
# VITE_API_BASE_URL="https://your-api-domain.com/api"
